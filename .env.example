# Server
PORT=3000
NODE_ENV=production
# SQLite file (inside the container this is /app/data/todo.db)
DB_PATH=./data/todo.db
# Bearer token required on /api and /mcp. Generate: openssl rand -hex 32
API_TOKEN=
# Optional gbrain selective sync (leave empty to disable)
GBRAIN_URL=
GBRAIN_TOKEN=
# Cloudflare Tunnel token (only needed for the optional `tunnel` compose profile)
TUNNEL_TOKEN=
# Host port published by docker compose (container always listens on 3000)
HOST_PORT=3080
