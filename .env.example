# Server
PORT=3000
NODE_ENV=production
# SQLite file (inside the container this is /app/data/todo.db)
DB_PATH=./data/todo.db
# Bearer token required on /api and /mcp. Generate: openssl rand -hex 32
API_TOKEN=
# Optional gbrain selective sync (leave empty to disable). GBRAIN_URL is the MCP endpoint.
# Either a static bearer token (GBRAIN_TOKEN) or OAuth client_credentials (GBRAIN_CLIENT_ID + SECRET;
# token endpoint defaults to <origin>/token, override with GBRAIN_TOKEN_URL).
GBRAIN_URL=
GBRAIN_TOKEN=
GBRAIN_CLIENT_ID=
GBRAIN_CLIENT_SECRET=
GBRAIN_TOKEN_URL=
GBRAIN_SCOPE=read write
# --- Claude-based auto classification of new todos (leave empty to disable) ---
# Fills blank tags / lead_days / due / goal on newly added todos and proposes goals. Never overrides user-given fields.
ANTHROPIC_API_KEY=
ENRICH_MODEL=claude-opus-5
# Max classifier calls per day (Asia/Seoul); beyond this, todos are stored without classification.
ENRICH_DAILY_CAP=200
# Cloudflare Tunnel token (only needed for the optional `tunnel` compose profile)
TUNNEL_TOKEN=
# Host port published by docker compose (container always listens on 3000)
HOST_PORT=3080
# --- OAuth 2.1 (needed for ChatGPT connectors; both must be set to enable) ---
# Public origin the tunnel exposes, no trailing slash
PUBLIC_URL=
# Owner password typed into the /authorize consent page (12+ chars). Generate: openssl rand -base64 18
OWNER_PASSWORD=
# Optional separate password for the web UI login (4+ chars, may be a PIN — protected by a 5-failure/15-minute lockout).
# Falls back to OWNER_PASSWORD when empty.
WEB_PASSWORD=
# Pre-registered public PKCE client id and allowed redirect URIs (comma separated).
# https://chatgpt.com/connector/oauth/<id> is always accepted in addition to this list.
OAUTH_CLIENT_ID=chatgpt
OAUTH_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect
# Multiple clients (overrides the two lines above): id|redirect1,redirect2[|secret];...
# A client with a secret is confidential (client_secret_post / basic) — use for claude.ai custom connectors.
# OAUTH_CLIENTS=chatgpt|https://chatgpt.com/connector_platform_oauth_redirect;claude|https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback|<openssl rand -hex 32>
