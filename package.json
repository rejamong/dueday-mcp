{
  "name": "dueday-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Personal TODO MCP server with due-date lead-time reminders, built for ChatGPT/Claude connectors",
  "license": "MIT",
  "repository": "github:rejamong/dueday-mcp",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/mcp": "^0.3.2",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "hono": "^4.13.7",
    "ulid": "^3.0.2",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@vitest/coverage-v8": "^5.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
